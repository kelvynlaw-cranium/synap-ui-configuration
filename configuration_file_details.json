{
  "synapui": "1.0.0",
  "info": {
    "title": "Test UI Definition",
    "version": "0.0.1",
    "description": "Main SynapUI Definition",
    "contact": {
      "name": "Cranium Ventures",
      "url": "https://www.craniumventures.com",
      "email": "info@craniumventures.com"
    }
  },
  "storyboards": {
    "configuration_file_details": {
      "title": "Main storyboard",
      "description": "Storyboard to present upon loaded",
      "screens": {
        "main": {
          "*": {
            "0": {
              "view": {
                "type": "stack",
                "orientation": "vertical",
                "style": {
                  "color": "#F2F4F7",
                  "size": {
                    "height": {
                      "type": "fill-parent"
                    },
                    "width": {
                      "type": "fill-parent"
                    }
                  }
                },
                "views": {
                  "fileNameLabel": {
                    "type": "label",
                    "style": {
                      "color": "#494D4F",
                      "margin": {
                        "*": {
                          "top": 8,
                          "left": 20
                        }
                      },
                      "text": {
                        "name": "Mobile/Heading/H3",
                        "font": {
                          "*": {
                            "size": 16,
                            "weight": "semiBold"
                          }
                        }
                      }
                    },
                    "data": {
                      "sources": {
                        "local.filePathValue": {
                          "type": "string",
                          "constantValue": "$KSHARE_LOCAL_DIR/knode.cfg"
                        }
                      }
                    }
                  },
                  "filePathLabel": {
                    "type": "label",
                    "style": {
                      "color": "#6D7172",
                      "margin": {
                        "*": {
                          "top": 8,
                          "left": 20
                        }
                      },
                      "text": {
                        "name": "Mobile/Body/Medium/Regular",
                        "font": {
                          "*": {
                            "size": 13
                          }
                        }
                      }
                    },
                    "data": {
                      "sources": {
                        "local.filePathValue": {
                          "type": "string",
                          "constantValue": "$KSHARE_LOCAL_DIR/knode.cfg"
                        }
                      }
                    }
                  },
                  "infoScrollView": {
                    "type": "scrollView",
                    "style": {
                      "size": {
                        "height": {
                          "type": "fill-parent"
                        },
                        "width": {
                          "type": "fill-parent"
                        }
                      },
                      "color": "#1E1E1E",
                      "border": {
                        "radius": {
                          "topLeft": 12,
                          "topRight": 12
                        }
                      },
                      "margin": {
                        "*": {
                          "top": 16
                        }
                      }
                    },
                    "views": {
                      "inputCon": {
                        "type": "stack",
                        "orientation": "vertical",
                        "style": {
                          "size": {
                            "width": {
                              "type": "fill-parent"
                            }
                          }
                        },
                        "views": {
                          "inputField": {
                            "type": "textView",
                            "style": {
                              "size": {
                                "width": {
                                  "type": "fill-parent"
                                }
                              },
                              "margin": {
                                "*": {
                                  "top": 16,
                                  "left": 20,
                                  "right": 20
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "navigator": {
                "type": "navigator",
                "hidden": false,
                "style": {
                  "color": "#F2F4F7"
                }
              }
            }
          }
        }
      }
    }
  }
}